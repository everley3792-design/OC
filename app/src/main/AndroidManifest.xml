<?xml version="1.0" encoding="utf-8"?>
<!-- OC Shimeji (reboot). M0: one activity drawing everything through the game's own renderer.
     The desktop pet (overlay service, specialUse) arrives in M3. versionCode/versionName must match gradle.properties. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.ocshimeji"
    android:versionCode="100"
    android:versionName="0.1.0-reboot">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:hardwareAccelerated="true">
        <activity
            android:name=".android.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
