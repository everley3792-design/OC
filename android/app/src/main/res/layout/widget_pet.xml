<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (RemoteViews-safe views only). Colours from values / values-night. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/w_avatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_fg"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_mood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="@color/widget_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_todo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="@color/widget_fg"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/oc_accent"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_pet"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_btn"
        android:gravity="center"
        android:minWidth="64dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:textColor="@color/widget_btn_fg"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
