<resources>
    <style name="Theme.OC" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/oc_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/oc_accent</item>
    </style>
    <!-- launch: Android 12+ system splash uses the app icon on windowBackground; older versions show this layer-list -->
    <style name="Theme.OC.Launch">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
